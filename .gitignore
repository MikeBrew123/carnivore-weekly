!data/wiki-keywords.json
!data/newsletter_content.json
!data/newsletter_affiliates.json
!data/scoreboard.json
# Persistent creator roster for the channels page — must be committed or
# appearance counts reset to zero on every fresh checkout
!data/creator_history.json
# Writer persona definitions read by answer_questions.py. Untracked meant CI
# generated every Q&A answer with an empty persona context and only a warning.
!data/personas.json

# Generated content
public/weekly/*.html
public/creators/*.html
public/studies/*.html

# Source image files (site serves webp versions)
images/*.png
images/**/*.png

# Video files
*.mp4
*.mov
*.avi

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Thumbnails and temp files
*.tmp
.cache/

# Node modules (if using Node.js)
node_modules/
package-lock.json
# EXCEPTION: the coach app is built by Vercel from a fresh clone. Without a
# committed lockfile Vercel runs `npm install`, resolves caret ranges to newer
# releases than the ones developed against, and the build breaks on drift
# (2026-08-25: stripe ^22.2.0 resolved to 22.5.0, whose types require a newer
# pinned apiVersion, failing every production deploy). Commit this one lockfile
# so Vercel can run `npm ci` and builds are reproducible.
!ketodial/coach-app/package-lock.json

# API Keys and secrets
# CRITICAL: Never commit the secrets/ folder with actual credentials
# Only the .gitkeep file is tracked to maintain folder structure
secrets/
*.key
*.pem

# OS specific
Thumbs.db

# Third-party repos
gemini-code-assist-mcp/

# Archived deprecated files
archive/
logs/
public/ux-analysis/

# Claude Code working directories
.claude/worktrees/
tmp/

# Wrangler build artifacts
api/.wrangler/tmp/

# n8n workflow exports — contain inline credentials (Authorization headers, tokens).
# Source of truth is the n8n instance itself; never commit exports.
# Blocked by .git/hooks/pre-commit secret scanner as a backstop.
n8n-workflows/
.next/

# Paid product masters — never commit to this PUBLIC repo (cleanup 2026-07-14).
# Etsy deliverables live here as the product warehouse; masters kept in private backup.
# NOTE: public/downloads/** is deliberately force-included above (on-site shop fulfillment) — do not undo.
etsy/products/**/*.pdf
etsy/products/**/*.zip

# Etsy daily snapshot data (Phase A2) — business metrics, keep OUT of this public repo.
# The snapshot SCRIPT (etsy/etsy-snapshot.mjs) is committed; the DATA is not.
reports/etsy-snapshots/

# Wrangler local dev secrets (never commit)
.dev.vars
api/.dev.vars
.env.bak*
.env.backup*
etsy/products/pdfs/

# Etsy image build scratch — intermediate composites, regenerable from the scripts.
etsy/_build/

# Reddit trend data: snapshots ARE tracked (the Sunday newsletter Actions run
# reads them); the local-only history archive and comment dumps are not.
data/reddit-trends-history.jsonl
data/reddit-comments-*.json
!data/reddit-trends-cw.json
!data/reddit-trends-kd.json
