{
  "permissions": {
    "allow": [
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__283a3d61-3bef-4f69-92a8-c32d6e8b16df__otter_search",
      "mcp__283a3d61-3bef-4f69-92a8-c32d6e8b16df__otter_fetch",
